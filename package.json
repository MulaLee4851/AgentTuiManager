{
  "name": "agent-tui-manager",
  "version": "0.3.16",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pretest": "electron-vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --dir tests",
    "test:watch": "vitest --dir tests",
    "build:native": "node scripts/build-native-bridge.mjs",
    "predev": "npm run build:native",
    "prebuild": "npm run build:native",
    "dist:win": "npm run build && node node_modules/electron-builder/out/cli/cli.js --win nsis --x64",
    "dist:mac": "npm run build && node node_modules/electron-builder/out/cli/cli.js --mac dmg zip"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^5.3.0",
    "axios": "^1.19.0",
    "bufferutil": "^4.1.0",
    "dingtalk-stream": "^2.1.5",
    "node-pty": "^1.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "smol-toml": "^1.8.0",
    "sql.js": "^1.14.1",
    "utf-8-validate": "^6.0.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "com.agenttuimanager.desktop",
    "productName": "Agent TUI Manager",
    "asar": true,
    "afterSign": "scripts/verify-windows-executable.cjs",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "logo/AgentTuiManager.png",
      "artifactName": "Agent-TUI-Manager-Setup-${version}-x64.exe",
      "extraResources": [
        {
          "from": "build/native/AgentTui.NativeBridge.exe",
          "to": "native/AgentTui.NativeBridge.exe"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "logo/AgentTuiManager.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Agent-TUI-Manager-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent TUI Manager",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "dist-electron/**/*",
      "logo/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist"
  }
}
