new file mode 100644
--- /dev/null
+++ b/electron/claude-permission-hook.ts
@@ -0,0 +1,68 @@
+import { randomUUID } from 'node:crypto'
+import net from 'node:net'
+
+interface HookInput {
+  tool_name?: unknown
+  tool_input?: unknown
+}
+
+function readInput(): Promise<string> {
+  return new Promise((resolve) => {
+    let value = ''
+    process.stdin.setEncoding('utf8')
+    process.stdin.on('data', (chunk) => { value += chunk })
+    process.stdin.on('end', () => resolve(value))
+  })
+}
+
+function shellCommand(input: HookInput): string | undefined {
+  if (input.tool_name !== 'Bash' && input.tool_name !== 'PowerShell') return undefined
+  if (typeof input.tool_input !== 'object' || input.tool_input === null) return undefined
+  const command = (input.tool_input as Record<string, unknown>).command
+  return typeof command === 'string' && command.length <= 2_048 ? command : undefined
+}
+
+async function main(): Promise<void> {
+  const endpoint = process.env.AGENT_TUI_MANAGER_HOOK_ENDPOINT
+  const token = process.env.AGENT_TUI_MANAGER_HOOK_TOKEN
+  if (!endpoint || !token) return
+  let input: HookInput
+  try { input = JSON.parse(await readInput()) as HookInput } catch { return }
+  if (typeof input.tool_name !== 'string' || !input.tool_name) return
+
+  const requestId = randomUUID()
+  const response = await new Promise<'allow' | 'ask'>((resolve) => {
+    const socket = net.createConnection(endpoint)
+    let buffer = ''
+    let settled = false
+    const finish = (action: 'allow' | 'ask'): void => {
+      if (settled) return
+      settled = true
+      clearTimeout(timer)
+      socket.destroy()
+      resolve(action)
+    }
+    const timer = setTimeout(() => finish('ask'), 8_000)
+    socket.setEncoding('utf8')
+    socket.once('connect', () => socket.write(`${JSON.stringify({
+      type: 'permission-hook', token, requestId, toolName: input.tool_name,
+      ...(shellCommand(input) ? { command: shellCommand(input) } : {}),
+    })}\n`))
+    socket.on('data', (chunk) => {
+      buffer += chunk
+      const newline = buffer.indexOf('\n')
+      if (newline < 0) return
+      try {
+        const event = JSON.parse(buffer.slice(0, newline)) as { type?: string; action?: string }
+        finish(event.type === 'permission-response' && event.action === 'allow' ? 'allow' : 'ask')
+      } catch { finish('ask') }
+    })
+    socket.once('error', () => finish('ask'))
+  })
+
+  if (response === 'allow') {
+    process.stdout.write(JSON.stringify({
+      hookSpecificOutput: { hookEventName: 'PermissionRequest', decision: { behavior: 'allow' } },
+    }))
+  }
+}
+
+void main().finally(() => setTimeout(() => process.exit(0), 0))
